# THE 1969 Bot Configuration (v2)
# ================================

# Account cookies - get from browser DevTools after logging in
# DevTools > Application > Cookies > the1969_session
ACCOUNTS=[{"name":"main","cookie":"the1969_session=YOUR_COOKIE_HERE"}]

# Optional: proxy per account
PROXIES=[]

# Poll interval (ms)
POLL_INTERVAL=15000

# Enable/disable features
ENABLE_AUTO_CLAIM=true
ENABLE_TASK_CLAIM=true
