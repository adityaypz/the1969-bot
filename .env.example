# THE 1969 Bot Configuration
# ===========================

# Account cookies - get these from browser DevTools after logging in
# Format: JSON array of account objects
# Each account needs: name (label), cookie (session cookie string)
#
# To get cookies:
# 1. Go to https://the1969.io and log in with X
# 2. Open DevTools > Application > Cookies
# 3. Copy ALL cookie values (usually a session cookie)
# 4. Or: DevTools > Network > any /api/ request > Headers > Cookie
#
# Example:
# ACCOUNTS=[{"name":"main","cookie":"connect.sid=s%3A..."},{"name":"alt1","cookie":"connect.sid=s%3A..."}]
ACCOUNTS=[]

# Optional: proxy per account (rotating proxies recommended for multi-account)
# Format: JSON array matching ACCOUNTS order
# PROXIES=["http://user:pass@proxy1:8080","http://user:pass@proxy2:8080"]
PROXIES=[]

# Timing config (ms) - defaults are safe, tune if needed
POLL_INTERVAL=15000
CLAIM_DELAY_MIN=500
CLAIM_DELAY_MAX=2000
ARM_WAIT_BUFFER=200

# How many claims per session (max 3)
MAX_CLAIMS_PER_SESSION=3

# Enable/disable features
ENABLE_AUTO_CLAIM=true
ENABLE_TASK_CLAIM=false
